    [
      "006d9e50",
      "cm0102_load_event_configuration",
      "Loads localized events_*.cfg, falls back to English. Initializes677 records at B68788, stride18. Config IDs0..676; runtime event index\u003d(code\u00267fff)-8000. Variants stride110h; G/R strings at+108/+10c. EOF converts divisor values to inverse weights using maxDivisor*10/divisor, then sums. Full loader not emulated."
    ],
    [
      "006d5b50",
      "cm0102_release_event_configuration",
      "Frees game/report text and variant arrays for677 event definitions, excluding fallback B68670; clears loaded/language globals."
    ],
    [
      "006d5cd0",
      "cm0102_event_priority",
      "Returns signed-byte priority from record18*((code\u00267fff)-8000), or0 if index outside0..676. Original instructions checked for all65536 raw event codes under two synthetic priority tables."
    ],
    [
      "006d78b0",
      "cm0102_next_commentary_segment",
      "Advances display ring cursor at companion+C, reads game-text variant, handles pipe-separated segments and event-code bit8000. Event record+D is a signed segment cursor initialized-1. Exact original class/prototype not recovered."
    ],
    [
      "006d7b00",
      "cm0102_format_game_commentary_candidate",
      "Uses event variant+108 game text and token substitution. Pseudocode stack/prototype damaged around stack-probe helper; semantic role based on assembly/data accesses, not guessed signature."
    ],
    [
      "006d8d10",
      "cm0102_format_report_commentary_candidate",
      "Uses event variant+10c report text and token substitution. Stack-probe confuses decompiler prototype; do not apply inferred full signature."
    ],
    [
      "006d4250",
      "cm0102_stop_after_goal_rule",
      "Literal predicate: 16-bit period target !\u003d495 and !\u003d990, and fixture flags byte+38 bit80 set. Goal callers set match+1a8 and emit runtime1fd2, config146 EVENT_GOLDEN_GOAL. Predicate checked against original x86 for every16-bit target with flags0/80/7f/ff. Does not itself test tie/goal/valid-period conditions."
    ],
    [
      "006be710",
      "cm0102_advance_tiebreak_sequence",
      "Config/announcement bridge identifies phases1/2/3 as35-yard shootout and4/5/6 aspenalty shootout. Dispatcher phase1 emits2003 (config195); other nonzero entry emits2002 (config194). First variant starts side1, second chooses first side through RNG. Full attempts/outcomes not emulated."
    ],
    [
      "006b98c0",
      "cm0102_advance_match_candidate",
      "Event mapping resolves exceptional status8 to pitch-condition abandonment (runtime217b/config571). Threshold+F638 is a signed minute threshold, -1disabled. Phase1 announces35-yard shootout; phase4 announcespenalties. Config meanings from pinned community data, not pristine publisher-authenticated text."
    ],
    [
      "006d6f70",
      "cm0102_enqueue_commentary_event",
      "Runtime event definition index\u003d(eventCode\u00267fff)-8000 atB68788 with18-byte stride. Weighted variant choices refer to272-byte entries; variant count short+C and weight total int+E. Event record+D is segment cursor, initially-1, rather than an unidentified flag."
    ]
